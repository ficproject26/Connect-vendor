{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://connect-vendor-p1ij.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://connect-vendor-p1ij.onrender.com/uploads/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}