# Frontend Environment Variables Example (Vite)

# API Base URL for local development or production
# For local dev: http://localhost:8002/api
# For Vercel deployment: https://connect-vendor.onrender.com/api
VITE_API_URL=http://localhost:8002/api

# Deployed Backend Root URL (Fallback for production deployment)
VITE_BACKEND_URL=https://connect-vendor.onrender.com

# Admin Backend URL (Optional)
VITE_ADMIN_BACKEND_URL=https://connect-admin-96pc.onrender.com

# Auto-sync interval in milliseconds
VITE_SYNC_INTERVAL=30000
