# Environment Variables for Vite Frontend (Vercel deployment)

# Set this in Vercel project settings under Environment Variables:
# VITE_API_URL=https://connect-vendor.onrender.com/api
# OR
# VITE_BACKEND_URL=https://connect-vendor.onrender.com

VITE_API_URL=http://localhost:8002/api
VITE_SYNC_INTERVAL=30000
